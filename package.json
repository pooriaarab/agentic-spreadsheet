{
  "name": "agentic-spreadsheet",
  "version": "0.14.2",
  "description": "Spreadsheets with formulas that people and agents edit together.",
  "keywords": [
    "spreadsheet",
    "sheets",
    "formulas",
    "grid",
    "collaboration",
    "agents",
    "mcp",
    "cli",
    "csv",
    "xlsx"
  ],
  "license": "MIT",
  "author": "Pooria Arab",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pooriaarab/agentic-spreadsheet.git"
  },
  "type": "module",
  "private": false,
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "mcpName": "io.github.pooriaarab/agentic-spreadsheet",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./formats": {
      "types": "./dist/formats.d.ts",
      "import": "./dist/formats.js"
    },
    "./ui": {
      "types": "./dist/embed.d.ts",
      "import": "./dist/embed.js"
    },
    "./ui.css": "./dist/embed.css",
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    },
    "./account": {
      "types": "./dist/account.d.ts",
      "import": "./dist/account.js"
    }
  },
  "bin": {
    "agentic-spreadsheet": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsup && vite build",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p ui",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "ci:local": "npm run build && npm run typecheck && npm test && npm run test:e2e",
    "dev:ui": "WRANGLER_SEND_METRICS=false wrangler dev",
    "test:e2e": "playwright test",
    "deploy:demo": "npm run build && WRANGLER_SEND_METRICS=false wrangler deploy --config wrangler.demo.jsonc",
    "dev": "npm run build && node scripts/dev.mjs",
    "dev:smoke": "node scripts/dev-smoke.mjs"
  },
  "dependencies": {
    "@formulajs/formulajs": "^4.6.1",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "agentic-design": ">=0.8.0 <0.11.0",
    "agentic-formats": "^0.4.2",
    "agentic-identity": ">=0.9.0 <0.11.0",
    "agentic-realtime": ">=0.4.3 <0.7.0",
    "hono": "^4.13.14",
    "yjs": "^13.6.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "esbuild": "^0.27.7",
    "jsdom": "^26.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vite": "^7.3.7",
    "vitest": "^3.0.0",
    "wrangler": "^4.155.0",
    "agentic-design": "0.10.0",
    "agentic-formats": "0.4.4",
    "agentic-identity": "0.10.0",
    "agentic-realtime": "0.6.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "overrides": {
    "agentic-formats": {
      "zod": "^4.6.6"
    }
  }
}
