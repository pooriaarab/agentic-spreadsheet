{
  "name": "agentic-spreadsheet",
  "version": "0.5.0",
  "description": "Spreadsheets with formulas that people and agents edit together.",
  "keywords": [
    "spreadsheet",
    "sheets",
    "formulas",
    "grid",
    "collaboration",
    "agents",
    "mcp",
    "cli",
    "csv",
    "xlsx"
  ],
  "license": "MIT",
  "author": "Pooria Arab",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pooriaarab/agentic-spreadsheet.git"
  },
  "type": "module",
  "private": false,
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "mcpName": "io.github.pooriaarab/agentic-spreadsheet",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    }
  },
  "bin": {
    "agentic-spreadsheet": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsup && vite build",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p ui",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "ci:local": "npm run build && npm run typecheck && npm test && npm run test:e2e",
    "dev:ui": "WRANGLER_SEND_METRICS=false wrangler dev",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@formulajs/formulajs": "^4.6.1",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "agentic-identity": "^0.5.0",
    "hono": "^4.13.14",
    "yjs": "^13.6.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "agentic-design": "^0.2.0",
    "agentic-realtime": "^0.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vite": "^7.3.7",
    "vitest": "^3.0.0",
    "wrangler": "^4.155.0"
  }
}
