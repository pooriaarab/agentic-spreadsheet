{
  "name": "agentic-spreadsheet",
  "main": "src/ui-worker.ts",
  "compatibility_date": "2026-01-01",
  // The root of agentic-identity imports node:module for its version string.
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "PACK_NAME": "agentic-spreadsheet"
  },
  // The web UI. Run `npm run build` first. The Worker answers /api and /health, and serves the rest from here.
  "assets": { "directory": "./dist/ui", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*", "/health"] },
  // One room per workbook carries presence.
  "durable_objects": { "bindings": [{ "name": "SYNC_ROOM", "class_name": "SyncRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SyncRoom"] }],
  // Workbooks live here. Create the database with `wrangler d1 create agentic-spreadsheet --location weur`, then put its id below.
  // Create the bucket with `wrangler r2 bucket create agentic-spreadsheet-data --jurisdiction eu`.
  // Set SHEETS_REGION to "eu" or "us" as a var or a secret: it states where the data lives, and has no default.
  "d1_databases": [{ "binding": "DB", "database_name": "agentic-spreadsheet", "database_id": "00000000-0000-0000-0000-000000000000" }],
  "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "agentic-spreadsheet-data", "jurisdiction": "eu" }]
}
